{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-0/event.schema.json",
  "title": "Content-0 event graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "entry", "nodes"],
  "properties": {
    "schemaVersion": {"const": "content-0"},
    "id": {"$ref": "map.schema.json#/$defs/id"},
    "entry": {"type": "integer", "minimum": 0, "maximum": 255},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 0, "maximum": 255},
    "successor": {"type": "integer", "minimum": 0, "maximum": 255},
    "value": {"type": "integer", "minimum": 0, "maximum": 999999999},
    "byteCount": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "node": {"oneOf": [
      {"type": "object", "additionalProperties": false,
        "required": ["id", "op", "key", "value", "next"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "setValue"},
          "key": {"$ref": "#/$defs/value"}, "value": {"$ref": "#/$defs/value"},
          "next": {"type": "array", "minItems": 1, "maxItems": 1,
            "items": {"$ref": "#/$defs/successor"}}}},
      {"type": "object", "additionalProperties": false,
        "required": ["id", "op", "entity", "bytes", "next"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "addEntity"},
          "entity": {"$ref": "#/$defs/value"}, "bytes": {"$ref": "#/$defs/byteCount"},
          "next": {"type": "array", "minItems": 1, "maxItems": 1,
            "items": {"$ref": "#/$defs/successor"}}}},
      {"type": "object", "additionalProperties": false,
        "required": ["id", "op", "kind", "bytes", "next"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "emitSignal"},
          "kind": {"$ref": "#/$defs/value"}, "bytes": {"$ref": "#/$defs/byteCount"},
          "next": {"type": "array", "minItems": 1, "maxItems": 1,
            "items": {"$ref": "#/$defs/successor"}}}},
      {"type": "object", "additionalProperties": false,
        "required": ["id", "op", "ticks", "next"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "wait"},
          "ticks": {"$ref": "#/$defs/value"},
          "next": {"type": "array", "minItems": 1, "maxItems": 1,
            "items": {"$ref": "#/$defs/successor"}}}},
      {"type": "object", "additionalProperties": false,
        "required": ["id", "op", "prompt", "next"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "choice"},
          "prompt": {"$ref": "#/$defs/value"},
          "next": {"type": "array", "minItems": 2, "maxItems": 2,
            "items": {"$ref": "#/$defs/successor"}}}},
      {"type": "object", "additionalProperties": false,
        "required": ["id", "op", "next"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "stop"},
          "next": {"type": "array", "maxItems": 0}}}
    ]}
  }
}
