{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-0/encounter.schema.json",
  "title": "Content-0 encounter roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "entries"],
  "properties": {
    "schemaVersion": {"const": "content-0"},
    "id": {"$ref": "#/$defs/id"},
    "entries": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/entry"}},
    "itemRewards": {"type": "array", "maxItems": 256,
                    "items": {"$ref": "#/$defs/itemReward"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z][a-z0-9_-]{0,31}$"},
    "itemReward": {
      "type": "object", "additionalProperties": false,
      "required": ["item", "quantity"],
      "properties": {
        "item": {"$ref": "#/$defs/id"},
        "quantity": {"type": "integer", "minimum": 1, "maximum": 9999}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["species"],
      "properties": {
        "species": {"$ref": "#/$defs/id"},
        "level": {"type": "integer", "minimum": 1, "maximum": 200},
        "weight": {"type": "integer", "minimum": 1, "maximum": 10000},
        "minLevel": {"type": "integer", "minimum": 1, "maximum": 200},
        "maxLevel": {"type": "integer", "minimum": 1, "maximum": 200}
      },
      "oneOf": [
        {"not": {"anyOf": [{"required": ["level"]},
                              {"required": ["minLevel"]},
                              {"required": ["maxLevel"]}]}},
        {"required": ["level"],
         "not": {"anyOf": [{"required": ["minLevel"]},
                             {"required": ["maxLevel"]}]}},
        {"required": ["minLevel", "maxLevel"],
         "not": {"required": ["level"]}}
      ]
    }
  }
}
