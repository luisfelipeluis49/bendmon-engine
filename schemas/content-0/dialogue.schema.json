{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-0/dialogue.schema.json",
  "title": "Content-0 dialogue text",
  "description": "Bounded ordered text data; it has no display or event execution semantics by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "lines"],
  "properties": {
    "schemaVersion": {"const": "content-0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z][a-z0-9_-]{0,31}$"},
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["speaker", "text"],
        "properties": {
          "speaker": {"type": "string", "minLength": 1, "maxLength": 128},
          "text": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
