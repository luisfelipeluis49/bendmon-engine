{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-0/trainer.schema.json",
  "title": "Content-0 trainer metadata",
  "description": "Inert identity and display name only; this record does not define battle or training behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name"],
  "properties": {
    "schemaVersion": {"const": "content-0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z][a-z0-9_-]{0,31}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
